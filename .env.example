# CSL-Meter environment configuration.
# Copy to .env (or export in your shell / service unit) and fill in real
# values. Every value below is a placeholder — never commit a filled .env.

# --- Storage ---------------------------------------------------------------
# Path to the SQLite database file. Defaults to ./data/csl_meter.db
# next to app.py when unset.
CSL_DB_PATH=/path/to/csl_meter.db

# --- HTTP bind ---------------------------------------------------------------
# The app binds localhost by default; put a reverse proxy in front of it
# for public traffic (the demo deployment does exactly that).
HOST=127.0.0.1
PORT=8090

# --- Access gate (optional) --------------------------------------------------
# When CSL_GATE_PASSWORD_SHA256 is set, requests arriving through a reverse
# proxy (X-Forwarded-For present) must log in first. Leave it empty to run
# without the gate.
CSL_GATE_USER=admin
# SHA-256 hex digest of the gate password — the password itself is never
# stored or read by the app. Generate it with:
#   python3 -c "import hashlib,getpass;print(hashlib.sha256(getpass.getpass().encode()).hexdigest())"
CSL_GATE_PASSWORD_SHA256=REPLACE_WITH_SHA256_HEX_OF_YOUR_GATE_PASSWORD

# --- Cloudflare Turnstile (probe submissions) --------------------------------
# Server-side verification is FAIL-CLOSED: with no secret configured, probe
# submissions are rejected outright. Get both keys from the Cloudflare
# Turnstile dashboard for your domain.
TURNSTILE_SITE_KEY=REPLACE_WITH_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=REPLACE_WITH_TURNSTILE_SECRET_KEY
